# AI Provider Configuration
# Set at least one API key below

# OpenAI (get your key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (get your key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Choose your default provider: "openai" or "gemini"
DEFAULT_PROVIDER=openai

# Model selection (optional, defaults are fine)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

# Server settings (usually no need to change)
HOST=127.0.0.1
PORT=18080
